# Required for the Finnhub adapter (profile, news)
FINNHUB_API_KEY=

# Required for the EDGAR adapter (filings)
# Format: "Your Name your@email" — SEC fair-access policy requires identifying UA
SEC_USER_AGENT=

# Required for v0.3+ (LLM critic, not used in v0.1)
# ANTHROPIC_API_KEY=

# yfinance (price_action) needs no key.
# No social source ships in v0.1 — see CLAUDE.md "Social source dropped
# from v0.1" for the rationale. If a future social adapter lands, its
# env vars get added here.

# Note: this file is documentation only. Export real values in your shell;
# do not write them here. .env.* files (except this one) are gitignored.
