FINNHUB_API_KEY=

# Required for Phase 3 (SEC EDGAR adapter)
# Format: "Your Name your@email" — SEC fair-access policy requires identifying UA
SEC_USER_AGENT=

# Required for Phase 4 (Reddit adapter)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

